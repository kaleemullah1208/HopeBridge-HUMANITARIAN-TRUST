rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'admin@gmail.com' ||
        request.auth.token.email == 'admin@ngo.org' ||
        request.auth.token.email == 'admin@givehope.ngo' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin'
      );
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isUser(userId) || isAdmin();
      allow create: if isUser(userId) || isAdmin();
      allow update: if (isUser(userId) && request.resource.data.role == resource.data.role) || isAdmin();
      allow delete: if isAdmin();
    }

    // Aid Requests (Beneficiary / Welfare Assistance)
    match /aid_requests/{requestId} {
      allow read: if isAdmin() || (isAuthenticated() && (
        resource.data.applicantId == request.auth.uid ||
        resource.data.email == request.auth.token.email
      ));
      allow create: if true; // Public aid applicants & guest applicants
      allow update, delete: if isAdmin();
    }

    // Donations Collection
    match /donations/{donationId} {
      allow read: if isAdmin() || (isAuthenticated() && (
        resource.data.donorId == request.auth.uid ||
        resource.data.email == request.auth.token.email
      ));
      allow create: if true; // Public & guest donations
      allow update, delete: if isAdmin();
    }

    // Volunteers Collection
    match /volunteers/{volunteerId} {
      allow read: if isAdmin() || (isAuthenticated() && (
        resource.data.email == request.auth.token.email ||
        resource.data.applicantId == request.auth.uid
      ));
      allow create: if true; // Public volunteer applications
      allow update, delete: if isAdmin();
    }

    // Campaigns & Projects (Public view, Admin management)
    match /campaigns/{campaignId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Live Activity Stream
    match /activities/{activityId} {
      allow read: if true;
      allow create: if isAuthenticated() || true;
      allow update, delete: if isAdmin();
    }

    // NGO Global Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Fallback: Deny any other unmatched collections by default
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
